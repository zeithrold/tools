{
  "name": "@ztd-me/frontend-checks",
  "version": "0.1.3",
  "type": "module",
  "license": "MIT",
  "description": "Native CSS and Playwright accessibility checks for zt frontend profiles",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.22.0",
  "exports": {
    "./css": {
      "types": "./src/css.d.ts",
      "import": "./src/css.mjs"
    },
    "./playwright": {
      "types": "./src/playwright.d.ts",
      "import": "./src/playwright.mjs"
    }
  },
  "bin": {
    "ztd-css": "./src/css-cli.mjs"
  },
  "files": [
    "src",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint src scripts test playwright.config.mjs eslint.config.js --max-warnings 0",
    "typecheck": "tsc -p test/types/tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:pack": "node scripts/pack-smoke.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run test:browser && pnpm run test:pack",
    "prepublishOnly": "pnpm run check",
    "test:registry": "node scripts/registry-smoke.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "color-name": "2.0.0",
    "fast-glob": "3.3.3",
    "postcss": "8.5.27",
    "postcss-value-parser": "4.2.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.62.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "24.12.0",
    "@ztd-me/eslint": "0.1.1",
    "eslint": "10.11.0",
    "tailwindcss": "4.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeithrold/tools.git",
    "directory": "packages/frontend-checks"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
