{
  "name": "@ztd-me/ui",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Editable generic React UI source registry and private verification harness",
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeithrold/tools.git",
    "directory": "packages/ui"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./fonts-serif.css": {
      "types": "./dist/fonts-serif.css.d.ts",
      "default": "./dist/fonts-serif.css"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "patches"
  ],
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "get-nonce": "1.0.1",
    "lucide-react": "1.49.0",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@ztd-me/eslint": "0.1.1",
    "@ztd-me/frontend-checks": "0.1.1",
    "eslint": "10.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/build-assets.mjs",
    "lint": "eslint src scripts test eslint.config.js playwright.config.mjs css-check.config.mjs --max-warnings 0",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "css": "node ../frontend-checks/src/css-cli.mjs css-check.config.mjs",
    "test": "node --test test/*.test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:browser": "playwright test",
    "test:source": "node scripts/source-smoke.mjs",
    "test:evidence": "node scripts/verify-browser-evidence.mjs",
    "check": "pnpm run lint && pnpm run css && pnpm run typecheck && pnpm run build && pnpm test && pnpm run test:pack && pnpm run test:source && pnpm run test:evidence",
    "prepack": "pnpm run build"
  },
  "private": true
}
