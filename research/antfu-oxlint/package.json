{
  "name": "antfu-oxlint-bridge-research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "inventory": "node scripts/inventory.mjs",
    "experiment": "node scripts/experiment.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "summarize": "node scripts/summarize.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint --config eslint.config.mjs prototype scripts test",
    "reproduce": "npm run inventory && npm run experiment && npm test && npm run benchmark && npm run summarize"
  },
  "dependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@eslint-react/eslint-plugin": "5.23.3",
    "@oxlint/migrate": "1.86.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-format": "2.0.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-solid": "0.17.1",
    "eslint-plugin-svelte": "3.23.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "svelte": "5.57.1",
    "svelte-eslint-parser": "1.8.1",
    "typescript": "6.0.3"
  }
}
